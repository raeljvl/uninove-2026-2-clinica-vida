
@model IEnumerable<ClinicaVida.Web.Models.Especialidade>
@using System.Collections.Generic

@{
    var contagem = ViewBag.ContagemMedicos
        as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}

<h1>Especialidades médicas</h1>

<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Quantidade de médicos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var especialidade in Model)
        {
            <tr>
                <td>@especialidade.Nome</td>
                <td>@especialidade.Descricao</td>
                <td>
                    @(contagem.TryGetValue(especialidade.Id, out var total)
                        ? total
                        : 0)
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a href="/Medicos">Ver médicos</a></p>
